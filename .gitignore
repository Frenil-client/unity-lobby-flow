# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Unity build output
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# Addressables / test artifacts
# addressables_content_state.bin 은 콘텐츠 업데이트 빌드에 필요하므로 추적한다
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Ss]erverData/
InitTestScene*.unity

# Profiler / 메모리 계측 원본 — 결과 요약만 문서로 남긴다
/*.data
/*.snap

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# IDE
.vs/
.idea/
.history/
*.vsix
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Build artifacts
[Bb]in/
[Dd]ebug/
[Rr]elease/
artifacts/
publish/
[Tt]est[Rr]esult*/

# Binaries — 플러그인은 Assets/Packages 안에 들어오므로 되살린다
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
!/[Aa]ssets/**/*.dll
!/[Aa]ssets/**/*.so
!/[Aa]ssets/**/*.dylib
!/[Aa]ssets/**/*.a
!/[Aa]ssets/**/*.lib
!/[Pp]ackages/**/*.dll
!/[Pp]ackages/**/*.so
!/[Pp]ackages/**/*.dylib
!/[Pp]ackages/**/*.a

# Markdown — README 와 README 가 링크하는 문서만 추적한다
*.md
!README.md
!/docs/**/*.md

# Claude Code 로컬 설정
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
